# Configuración del proyecto
PROJECT_NAME=DflayerApi
VERSION=0.1.0
API_V1_STR=/api/v1

# Seguridad
SECRET_KEY=001fb1b592209880b234307ec163d42174796484f50d188b3f55cadf46d880aa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Base de datos
# Ejemplo para PostgreSQL: postgresql://user:password@localhost/dbname
# Ejemplo para SQLite: sqlite:///./dflayer.db
DATABASE_URL=postgresql://postgres:emi0731@localhost:5432/dflayer_db

# CORS - Orígenes permitidos separados por comas
BACKEND_CORS_ORIGINS=*

# CORS - Orígenes permitidos separados por comas
#BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Configuración del servidor
DEBUG=True

# Email Provider Selection
# Opciones: "smtp" o "sendgrid"
EMAIL_PROVIDER=smtp

# SMTP - Envío de correos electrónicos (Gmail compatible)
# Configuración para Gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=automaticprod96@gmail.com
SMTP_PASSWORD=zmef ltkx ztlg pvgi
SMTP_FROM_EMAIL=info@dflayer.com
SMTP_FROM_NAME=DflayerApi
SMTP_USE_TLS=True

# Para otros proveedores SMTP:
# Outlook/Hotmail: SMTP_SERVER=smtp-mail.outlook.com, SMTP_PORT=587
# Yahoo: SMTP_SERVER=smtp.mail.yahoo.com, SMTP_PORT=587
# Servidor personalizado: Configura SMTP_SERVER y SMTP_PORT según tu proveedor

# SendGrid - Envío de correos electrónicos (alternativa)
# Descomenta y configura si prefieres usar SendGrid en lugar de SMTP
# SENDGRID_API_KEY=your-sendgrid-api-key-here
# SENDGRID_FROM_EMAIL=noreply@tudominio.com
# SENDGRID_FROM_NAME=DflayerApi

# AWS S3 - Almacenamiento de archivos
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=  # Opcional: para usar S3-compatible services (MinIO, etc.)

# Transcodificación de contenido
TRANSCODING_WORKER_COUNT=4
TRANSCODING_MAX_RETRIES=3
TRANSCODING_QUEUE_SIZE=100
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Frontend URL (para enlaces en correos electrónicos)
FRONTEND_URL=http://localhost:3000

# PostgreSQL (para Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dflayer_db
POSTGRES_PORT=5432

# API Port
API_PORT=8000
